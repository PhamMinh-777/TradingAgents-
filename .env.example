# =====================================================================
# Cấu hình biến môi trường cho đề tài NCKH vn-llm-agents
# SAO CHÉP FILE NÀY THÀNH .env VÀ ĐIỀN CÁC KEY THẬT CỦA BẠN
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GITHUB
# =====================================================================

# 1. VNSTOCK API KEY (lấy từ https://vnstocks.com)
VNSTOCK_API_KEY=your_vnstock_api_key_here

# 2. LLM API Keys (Chọn ít nhất một nhà cung cấp)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Web crawler (Tùy chọn nếu dùng Firecrawl)
FIRECRAWL_API_KEY=
